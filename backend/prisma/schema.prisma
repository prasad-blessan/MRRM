generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationType {
  CLIENT
  AGENCY
}

// REG-02 / REG-03: registration lifecycle; only ACTIVE organizations can log in.
enum OrganizationStatus {
  PENDING_VERIFICATION
  PENDING_APPROVAL
  ACTIVE
  REJECTED
  DEACTIVATED
}

// PRD 5.1 user types.
enum UserRole {
  CLIENT_USER
  LS_ADMIN
  LS_USER
}

enum UserStatus {
  INVITED
  ACTIVE
  DEACTIVATED
}

enum EmailTokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

model Organization {
  id              String             @id @default(uuid()) @db.Uuid
  name            String
  type            OrganizationType
  status          OrganizationStatus @default(PENDING_VERIFICATION)
  address         String?
  timezone        String?
  // ADM-08 approval checklist.
  baaSigned       Boolean?           @map("baa_signed")
  msaReference    String?            @map("msa_reference")
  submittedAt     DateTime?          @map("submitted_at") @db.Timestamptz(3)
  decidedAt       DateTime?          @map("decided_at") @db.Timestamptz(3)
  decidedById     String?            @map("decided_by_id") @db.Uuid
  rejectionReason String?            @map("rejection_reason")
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  users           User[]
  requests        Request[]

  @@index([status])
  @@map("organizations")
}

model User {
  id                 String            @id @default(uuid()) @db.Uuid
  // Null for LevelShift staff (LS_ADMIN, LS_USER).
  organizationId     String?           @map("organization_id") @db.Uuid
  organization       Organization?     @relation(fields: [organizationId], references: [id])
  // Always stored lower-case (REG-07: emails are unique case-insensitively).
  email              String            @unique
  fullName           String            @map("full_name")
  phone              String?
  emailVerifiedAt    DateTime?         @map("email_verified_at") @db.Timestamptz(3)
  // CMP-12: accepted privacy notice / terms version.
  termsVersion       String?           @map("terms_version")
  termsAcceptedAt    DateTime?         @map("terms_accepted_at") @db.Timestamptz(3)
  passwordHash       String?           @map("password_hash")
  role               UserRole
  status             UserStatus        @default(INVITED)
  // REG-06 / REG-10: consecutive password + OTP failures.
  failedLoginCount   Int               @default(0) @map("failed_login_count")
  lockedUntil        DateTime?         @map("locked_until") @db.Timestamptz(3)
  lastLoginAt        DateTime?         @map("last_login_at") @db.Timestamptz(3)
  timezone           String?
  // Settings: status-change emails (NOT-01); emails never carry PHI (NOT-02).
  emailNotifications Boolean           @default(true) @map("email_notifications")
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions           Session[]
  loginChallenges    LoginChallenge[]
  emailTokens        EmailToken[]
  passwordHistory    PasswordHistory[]
  requests           Request[]
  uploads            RequestDocument[]

  @@index([organizationId])
  @@map("users")
}

// REG-02 / REG-05 / REG-08: single-use, expiring email links. Only the hash is stored.
model EmailToken {
  id        String            @id @default(uuid()) @db.Uuid
  userId    String            @map("user_id") @db.Uuid
  user      User              @relation(fields: [userId], references: [id])
  purpose   EmailTokenPurpose
  tokenHash String            @unique @map("token_hash")
  expiresAt DateTime          @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?         @map("used_at") @db.Timestamptz(3)
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId, purpose])
  @@map("email_tokens")
}

// REG-09: previous password hashes to block reuse of the last N passwords.
model PasswordHistory {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  user         User     @relation(fields: [userId], references: [id])
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId, createdAt])
  @@map("password_history")
}

// REG-04 / REG-10: one-time code issued after a correct password.
model LoginChallenge {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  user       User      @relation(fields: [userId], references: [id])
  codeHash   String    @map("code_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  attempts   Int       @default(0)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("login_challenges")
}

// REG-11 / SEC-10: server-side sessions with idle and absolute expiry.
model Session {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  user              User      @relation(fields: [userId], references: [id])
  tokenHash         String    @unique @map("token_hash")
  ip                String?
  userAgent         String?   @map("user_agent")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt        DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  idleExpiresAt     DateTime  @map("idle_expires_at") @db.Timestamptz(3)
  absoluteExpiresAt DateTime  @map("absolute_expires_at") @db.Timestamptz(3)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("sessions")
}

// SEC-02: append-only audit trail. No PHI/PII, file names or content.
model AuditLog {
  id             BigInt   @id @default(autoincrement())
  occurredAt     DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  event          String
  objectId       String?  @map("object_id")
  outcome        String
  ip             String?

  @@index([occurredAt])
  @@index([event])
  @@index([actorUserId])
  @@map("audit_logs")
}

// PRD 7.2 request lifecycle.
enum RequestStatus {
  RECEIVED
  ALLOCATED
  IN_PROCESSING
  SUMMARIZATION
  QC_VERIFICATION
  DELIVERED
  COMPLETED
  ON_HOLD
  REWORK
  REJECTED
  CANCELLED
}

// ADM: service catalogue; SLA drives the expected completion date.
model ServiceType {
  id        String    @id @default(uuid()) @db.Uuid
  code      String    @unique
  name      String
  slaHours  Int       @map("sla_hours")
  sortOrder Int       @default(0) @map("sort_order")
  active    Boolean   @default(true)
  requests  Request[]

  @@map("service_types")
}

// One submission (MR-xxxx) holding one or more documents.
model Request {
  id             String            @id @default(uuid()) @db.Uuid
  // Shown as MR-(1000 + number).
  number         Int               @unique @default(autoincrement())
  code           String            @unique
  organizationId String            @map("organization_id") @db.Uuid
  organization   Organization      @relation(fields: [organizationId], references: [id])
  submittedById  String            @map("submitted_by_id") @db.Uuid
  submittedBy    User              @relation(fields: [submittedById], references: [id])
  serviceTypeId  String            @map("service_type_id") @db.Uuid
  serviceType    ServiceType       @relation(fields: [serviceTypeId], references: [id])
  status         RequestStatus     @default(RECEIVED)
  // Workflow Monitor stage: 0 Allocation .. 4 Final Output, 5 = all done.
  stage          Int               @default(0)
  // Progress (0-100) of the current workflow stage.
  stageProgress  Int               @default(0) @map("stage_progress")
  receivedAt     DateTime          @default(now()) @map("received_at") @db.Timestamptz(3)
  expectedAt     DateTime          @map("expected_at") @db.Timestamptz(3)
  deliveredAt    DateTime?         @map("delivered_at") @db.Timestamptz(3)
  completedAt    DateTime?         @map("completed_at") @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  documents      RequestDocument[]
  events         StatusEvent[]

  @@index([organizationId, receivedAt])
  @@index([status])
  @@map("requests")
}

// A staged upload (requestId null) or a document of a submitted request.
model RequestDocument {
  id           String    @id @default(uuid()) @db.Uuid
  requestId    String?   @map("request_id") @db.Uuid
  request      Request?  @relation(fields: [requestId], references: [id])
  uploadedById String    @map("uploaded_by_id") @db.Uuid
  uploadedBy   User      @relation(fields: [uploadedById], references: [id])
  fileName     String    @map("file_name")
  mimeType     String    @map("mime_type")
  sizeBytes    Int       @map("size_bytes")
  pages        Int
  storageKey   String    @unique @map("storage_key")
  // Synthetic processed output (index + summary entries linked to source pages).
  output       Json?
  outputAt     DateTime? @map("output_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([requestId])
  @@index([uploadedById, requestId])
  @@map("request_documents")
}

// TRK-01: timestamped status history.
model StatusEvent {
  id          BigInt        @id @default(autoincrement())
  requestId   String        @map("request_id") @db.Uuid
  request     Request       @relation(fields: [requestId], references: [id])
  status      RequestStatus
  occurredAt  DateTime      @default(now()) @map("occurred_at") @db.Timestamptz(3)
  actorUserId String?       @map("actor_user_id") @db.Uuid

  @@index([requestId, occurredAt])
  @@map("status_events")
}
