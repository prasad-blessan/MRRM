DATABASE_URL=postgresql://mrrm_app:CHANGE_ME@127.0.0.1:5433/mrrm?schema=public
NODE_ENV=development
PORT=4000
APP_BASE_URL=http://localhost:5173
# At least 32 random characters
OTP_SECRET=
# console (dev only) | smtp
MAIL_TRANSPORT=console
SMTP_HOST=localhost
SMTP_PORT=1025
# Development seed accounts (synthetic data only)
SEED_ADMIN_PASSWORD=
SEED_CLIENT_PASSWORD=

# Uploaded files (outside the web root)
STORAGE_DIR=storage
MAX_UPLOAD_MB=100
# Development only: true moves requests through the workflow automatically with synthetic output (demo). Keep false for the real flow.
SIMULATE_WORKFLOW=false
# Development only: deleting storage/files/<request ID>/ removes that request from the app (default: on outside production)
SYNC_STORAGE_DELETES=true
